@{
    var categories = ViewBag.Categories as List<Category>;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <script>(function(w,i,g){w[g]=w[g]||[];if(typeof w[g].push=='function')w[g].push(i)})(window,'G-SEKJ4E9T4H','google_tags_first_party');</script>
    <script async src="/s9cc/"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('set', 'developer_id.dYzg1YT', true);
        gtag('config', 'G-SEKJ4E9T4H');
    </script>
    <meta name="robots" content="noindex, nofollow">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Psi Ooo° - Fashion E-commerce</title>

    <link href="https://fonts.googleapis.com/css2?family=Cookie&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" media="print" onload="this.media='all';this.onload=null;">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@7.1.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/css/glightbox.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="@Url.Content("~/css/elegant-icons.css")">
    <link rel="stylesheet" href="@Url.Content("~/css/style.css")">
</head>
<script>
    function scrollToTop() {
        window.scrollTo({
            top: 0,
            behavior: 'smooth'
        });
    }
</script>
<body>

    
    
    <script>(function(){try{var c=document.createElement("canvas");c.width=c.height=1;var s=c.toDataURL("image/webp").indexOf("webp")>0;document.documentElement.classList.add(s?"webp":"no-webp")}catch(e){document.documentElement.classList.add("no-webp")}})();</script>
    
    <div id="preloder">
        <div class="loader"></div>
    </div>
    <div class="offcanvas-menu-overlay"></div>
    
    <div class="offcanvas-menu-wrapper">
        <div class="offcanvas__close">+</div>
        <ul class="offcanvas__widget">
            <li>
                <span class="search-switch">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
            </li>
            <li>
                <a href="#">
                    <i class="fa-regular fa-heart"></i>
                    <div class="tip">2</div>
                </a>
            </li>
            <li>
                <a href="/shop_cart">
                    <i class="fa-solid fa-bag-shopping"></i>
                    <div class="tip cart-count">0</div>
                </a>
            </li>
        </ul>
        <div class="offcanvas__logo">
            <a href="/"><img src="@Url.Content("~/img/logo.png")" alt=""></a>
        </div>
        <div id="mobile-menu-wrap"></div>
        <div class="offcanvas__auth">
            <a href="/login">Login</a>
            <a href="/signup">Register</a>
        </div>
    </div>

    <header class="header" role="banner">
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-3 col-lg-2">
                    <div class="header__logo">
                        <a href="/"><img src="@Url.Content("~/img/logo.png")" alt="Home" fetchpriority="high" decoding="sync"></a>
                    </div>
                </div>
                
                @if (categories != null)
                {
                    @for(int i = 0; i < categories.Count && i < 5; i++)
                    {
                        <div class="col-xl-1 col-lg-2">
                            <nav class="header__menu" role="navigation" aria-label="Primary">
                                <ul>
                                    <li><a asp-controller="Category" asp-action="Index" asp-route-id="@categories[i].id">@categories[i].name</a></li>
                                </ul>
                            </nav>
                        </div>
                    }
                }
                
                <div class="col-lg-3 ms-auto">
                    <div class="header__right">
                        <div class="header__right__auth">
                            <a href="/login">Login</a>
                            <a href="/signup">Register</a>
                        </div>
                        <ul class="header__right__widget">
                            <li>
                                <a href="#" class="search-switch">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </a>
                            </li>
                            <li>
                                <a href="#">
                                    <i class="fa-regular fa-heart"></i>
                                    <div class="tip">2</div>
                                </a>
                            </li>
                            <li>
                                <a href="/shop_cart">
                                    <i class="fa-solid fa-bag-shopping"></i>
                                    <div class="tip cart-count">0</div>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="canvas__open">
                <i class="fa-solid fa-bars"></i>
            </div>
        </div>
    </header>

    @RenderBody()

    <div class="instagram">
        <div class="container-fluid">
            <div class="row">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="col-lg-2 col-md-4 col-sm-4 p-0">
                        <div class="instagram__item set-bg" data-setbg="@Url.Content($"~/img/instagram/insta-{i}.jpg")">
                            <div class="instagram__text">
                                <i class="fa-brands fa-instagram"></i>
                                <a href="#">&#64; FsiOo_shop</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <button class="scroll-to-top" onclick="scrollToTop()">↑</button>

    <footer class="footer">
        </footer>

    <div class="search-model" role="dialog" aria-modal="true" aria-label="Site search" id="search-modal" hidden>
        <div class="h-100 d-flex align-items-center justify-content-center">
            <button class="search-close-switch" type="button" aria-label="Close search">&times;</button>
            <form class="search-model-form" role="search" aria-label="Search products">
                <input type="search" id="search-input" name="search" placeholder="Search products..." autocomplete="off">
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.2.0/dist/js/glightbox.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="@Url.Content("~/js/main.js")"></script>

    @RenderSection("Scripts", required: false)

    <script>
    $(document).ready(function () {
        window.updateCartCount = function() {
            $.ajax({
                url: '/shop_cart/Count', // مطابقة لاسم الأكشن والكنترولر الافتراضي
                type: 'GET',
                cache: false,
                success: function (count) {
                    $('.cart-count').text(count.trim());
                },
                error: function (err) {
                    console.log("Error fetching cart count", err);
                }
            });
        }
        // استدعاء تلقائي عند تحميل الصفحة
        window.updateCartCount();
    });
</script>F
</body>
</html>