@{
    Layout = "~/Views/Shared/user/_userlayout.cshtml";
}
@model List<Favourite>

<section class="product spad">
    <div class="container">

        <div class="row mb-5">
            <div class="col-lg-12 text-center">
                <h2>
                    <i class="fa-solid fa-heart text-danger"></i>
                    Favourite Products
                </h2>
                <p class="text-muted">
                    @Model.Count Favourite Product(s)
                </p>
            </div>
        </div>
        <div class="row property__gallery">
            @foreach (var p in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mix @p.product.category.name">
                    <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="img/product/details/@p.product.image_url">
                            <ul class="product__hover">
                                <li>
                                    <a asp-controller="Product_details" asp-action="Index" asp-route-id="@p.product.id" asp-route-category_id="@p.product.category_id" asp-route-sup_category_id="@p.product.sup_category_id">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Favourite" asp-action="AddToFavourite" asp-route-userId="@ViewBag.userId" asp-route-productId="@p.product.id">
                                        <i class="fa-regular fa-heart"></i>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Home" asp-action="addshoptocart" asp-route-productId="@p.product.id" asp-route-userId="@ViewBag.userId">
                                        <i class="fa-solid fa-bag-shopping"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a href="product_details/@p.product.id">@p.product.name</a></h6>
                            <div class="rating">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                            </div>
                            <div class="product__price">@p.product.price EGP</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>