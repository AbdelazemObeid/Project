@{
    Layout = "~/Views/Shared/user/_userlayout.cshtml";
}
@model productandcat
<!-- Categories Section Begin -->
<section class="categories">
    <div class="container-fluid">
        <div class="row gx-4">
            <!-- <div class="row"> -->
            <div class="col-lg-6 p-0">
                <div class="categories__item categories__large__item set-bg"
                     data-setbg="img/categories/category-6.jpg">
                    <div class="categories__text">
                        <h1>Men’s fashion</h1>
                        <p>@Model.Product.Count(p => p.category.name == "Men" || p.category.name == "men") items</p>
                        <a asp-controller="category" asp-action="Index" asp-route-categoryId="@Model.Category.Where(c => c.name == "Men" || c.name == "men").Select(c => c.id).FirstOrDefault()">Shop now</a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 p-0">
                <div class="row g-0 h-100">
                    <div class="col-12 ">
                        <div class="categories__item set-bg"
                             data-setbg="img/categories/category-1.jpg">
                            <div class="categories__text">
                                <h4>Women’s fashion</h4>
                                <p>@Model.Product.Count(p => p.category.name == "Women" || p.category.name == "women") items</p>
                                <a asp-controller="category" asp-action="Index" asp-route-categoryId="@Model.Category.Where(c => c.name == "Women" || c.name == "women").Select(c => c.id).FirstOrDefault()">Shop now</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 ">
                        <div class="categories__item set-bg"
                             data-setbg="img/categories/category-3.jpg">
                            <div class="categories__text">
                                <h4>Kid’s fashion</h4>
                                <p>@Model.Product.Count(p => p.category.name == "Kids" || p.category.name == "kids") items</p>
                                <a asp-controller="category" asp-action="Index" asp-route-categoryId="@Model.Category.Where(c => c.name == "Kids" || c.name == "kids").Select(c => c.id).FirstOrDefault()">Shop now</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</section>
<!-- Categories Section End -->
<!-- Product Section Begin -->
<section class="product spad">
    <div class="container">
        <div class="Nav1">
            <div class="row">
                <div class="col-lg-4 col-md-4">
                    <div class="section-title">
                        <h4>New product</h4>
                    </div>
                </div>
                <div class="col-lg-8 col-md-8">
                    <ul class="filter__controls">
                        <li class="active" data-filter="*">All</li>
                        @if (ViewBag.categories.Count > 5)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    Categories
                                </a>

                                <ul class="dropdown-menu">
                                    @foreach (var c in ViewBag.categories)
                                    {
                                        <li class="dropdown-item" data-filter=".@c.name">@c.name</li>
                                    }
                                </ul>
                            </li>
                        }
                        else
                        {
                            @foreach (var c in ViewBag.categories)
                            {
                                <li data-filter=".@c.name">@c.name</li>
                            }
                        }
                        <!-- <li data-filter=".accessories">Accessories</li>
                    <li data-filter=".cosmetic">Cosmetics</li> -->
                    </ul>
                </div>
            </div>
        </div>

        <div class="row property__gallery">
            @foreach (var p in @Model.Product)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mix @p.category.name">
                    <div class="product__item">
                        <div class="product__item__pic set-bg" data-setbg="img/product/details/@p.image_url">
                            <ul class="product__hover">
                                <li>
                                    <a asp-controller="Product_details" asp-action="Index" asp-route-id="@p.id" asp-route-category_id="@p.category_id" asp-route-sup_category_id="@p.sup_category_id">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Favourite" asp-action="AddToFavourite" asp-route-userId="@ViewBag.userId" asp-route-productId="@p.id">
                                        <i class="fa-regular fa-heart"></i>
                                    </a>
                                </li>
                                <li>
                                    <a asp-controller="Home" asp-action="addshoptocart" asp-route-productId="@p.id" asp-route-userId="@ViewBag.userId">
                                        <i class="fa-solid fa-bag-shopping"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                        <div class="product__item__text">
                            <h6><a href="product_details/@p.id">@p.name</a></h6>
                            <div class="rating">
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                                <i class="fa-solid fa-star"></i>
                            </div>
                            <div class="product__price">@p.price EGP</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
<section class="banner">
    <div class="banner__slider">
        @foreach (var c in ViewBag.categories)
        {
            <div class="banner__item set-bg"
                 data-setbg="/img/banner/@c.image_url">

                <div class="container h-100">
                    <div class="row h-100">
                        <div class="col-xl-7 col-lg-8 m-auto">
                            <div class="banner__text">
                                <span>@c.name Collection</span>
                                <h1>The Project @c.name</h1>

                                <a asp-controller="Category"
                                   asp-action="Index"
                                   asp-route-categoryId="@c.id">
                                    Shop now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        }
    </div>
</section>
<!-- Banner Section End -->
