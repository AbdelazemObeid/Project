@model project_MVC.ViewModels.ShopVM
@{
    Layout = "~/Views/Shared/user/_userlayout.cshtml";
}

<style>
    .add-to-cart-ajax i {
        transition: .3s;
    }

    .add-to-cart-ajax.active-cart i {
        color: #ca1515 !important;
    }

    .add-to-cart-ajax:hover i {
        color: #ca1515;
    }
</style>

        <!-- Breadcrumb Begin -->
        <div class="breadcrumb-option">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="breadcrumb__links">
                            <a href="/Home/Index"><i class="fa-solid fa-house"></i> Home</a>
                            <span>Shop</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Breadcrumb End -->
        
        <!-- Shop Section Begin -->
        <section class="shop spad">
            <div class="container">
                <div class="row">
                    <div class="col-lg-3 col-md-3">
                        <div class="shop__sidebar">
                            <form method="get" asp-controller="shop" asp-action="Index" id="filterForm">
                                <div class="sidebar__categories">
                                    <div class="section-title">
                                        <h4>Categories</h4>
                                    </div>
                                    <div class="categories__accordion">
                                        <div class="accordion" id="accordionExample">
                                            
                                            <div class="card" style="border: none; margin-bottom: 5px;">
                                                <div class="card-heading" style="padding: 10px 0;">
                                                    <a href="/shop" style="font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: @(Model.SelectedCategoryId == null ? "700" : "500"); color: @(Model.SelectedCategoryId == null ? "#ca1515" : "#111"); text-decoration: none;">
                                                        All Categories
                                                    </a>
                                                </div>
                                            </div>

                                            @if (Model.Categories != null)
                                            {
                                                foreach (var category in Model.Categories)
                                                {
                                                    var isSelected = Model.SelectedCategoryId == category.id;
                                                    
                                                    <div class="card" style="border: none; margin-bottom: 5px;">
                                                        <div class="card-heading" style="padding: 10px 0;">
                                                            <a data-bs-toggle="collapse" href="#collapseCategory_@category.id" 
                                                               style="font-family: 'Montserrat', sans-serif; font-size: 14px; font-weight: @(isSelected ? "700" : "500"); color: @(isSelected ? "#ca1515" : "#111"); text-decoration: none;">
                                                                @category.name
                                                            </a>
                                                        </div>

                                                        <div id="collapseCategory_@category.id" class="collapse @(isSelected ? "show" : "")" data-bs-parent="#accordionExample">
                                                            <div class="card-body">
                                                                <ul>
                                                                    @if(category.items != null)
                                                                    {
                                                                        var subCatIds = Context.Request.Query["subCategoryIds"];
                                                                        foreach (var item in category.items.Select(i => i.sup_categories).Where(sc => sc != null).Distinct())
                                                                        {
                                                                            var isChecked = subCatIds.Contains(item.Id.ToString()) ? "checked" : null;
                                                                            <li>
                                                                                <label>
                                                                                    <input type="checkbox" name="subCategoryIds" value="@item.Id" checked="@isChecked" />
                                                                                    @item.Name
                                                                                </label>
                                                                            </li>
                                                                        }
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="sidebar__filter">
                                    <div class="section-title">
                                        <h4>Shop by price</h4>
                                    </div>
                                    <div class="filter-range-wrap">
                                        <div class="price-range ui-slider ui-corner-all ui-slider-horizontal ui-widget ui-widget-content"
                                             data-min="699" data-max="3000"></div>
                                        <div class="range-slider">
                                            <div class="price-input">
                                                <p>Price:</p>
                                                <input type="text" id="minamount" name="minPrice" value="@Context.Request.Query["minPrice"]">
                                                <input type="text" id="maxamount" name="maxPrice" value="@Context.Request.Query["maxPrice"]">
                                                <p>EGP</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="sidebar__sizes">
                                    <div class="section-title">
                                        <h4>Shop by size</h4>
                                    </div>
                                    
                                    @{
                                        var selectedSizes = Context.Request.Query["sizes"].ToList();
                                    }

                                    <div class="size__list">
                                        <label>xxs
                                            <input type="checkbox" name="sizes" value="XXS" @(selectedSizes.Contains("XXS") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>xs
                                            <input type="checkbox" name="sizes" value="XS" @(selectedSizes.Contains("XS") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>s
                                            <input type="checkbox" name="sizes" value="S" @(selectedSizes.Contains("S") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>m
                                            <input type="checkbox" name="sizes" value="M" @(selectedSizes.Contains("M") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>l
                                            <input type="checkbox" name="sizes" value="L" @(selectedSizes.Contains("L") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>xl
                                            <input type="checkbox" name="sizes" value="XL" @(selectedSizes.Contains("XL") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                </div>

                                <div class="sidebar__color">
                                    <div class="section-title">
                                        <h4>Shop by color</h4>
                                    </div>

                                    @{
                                        var selectedColors = Context.Request.Query["colors"].ToList();
                                    }

                                    <div class="size__list color__list">
                                        <label>Black
                                            <input type="checkbox" name="colors" value="Black" @(selectedColors.Contains("Black") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>White
                                            <input type="checkbox" name="colors" value="White" @(selectedColors.Contains("White") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>Red
                                            <input type="checkbox" name="colors" value="Red" @(selectedColors.Contains("Red") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>Grey
                                            <input type="checkbox" name="colors" value="Grey" @(selectedColors.Contains("Grey") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>Blue
                                            <input type="checkbox" name="colors" value="Blue" @(selectedColors.Contains("Blue") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                        <label>Green
                                            <input type="checkbox" name="colors" value="Green" @(selectedColors.Contains("Green") ? "checked" : "")>
                                            <span class="checkmark"></span>
                                        </label>
                                    </div>
                                </div>
                                <input type="hidden" name="search" value="@Model.Search" />
                            </form>
                        </div>
                    </div>
                    
                    <div class="col-lg-9 col-md-9">
                        <div class="shop__product__option">
                            <div class="row">
                                <div class="col-lg-6 col-md-6 col-sm-6">
                                    <div class="shop__product__option__left">
                                        <p>Showing @Model.Products.Count results</p>
                                    </div>
                                </div>
                                <div class="col-lg-6 col-md-6 col-sm-6">
                                    <div class="shop__product__option__right">
                                        <p>Sort by:</p>
                                        <select id="sortSelect" name="sort" form="filterForm">
                                            <option value="" selected="@(Context.Request.Query["sort"] == "")">Default</option>
                                            <option value="price-low" selected="@(Context.Request.Query["sort"] == "price-low")">Price: Low to High</option>
                                            <option value="price-high" selected="@(Context.Request.Query["sort"] == "price-high")">Price: High to Low</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row product__filter">
                            @foreach (var item in Model.Products)
                            {
                                <div class="col-lg-4 col-md-6">
                                    <div class="product__item">
                                        <div class="product__item__pic set-bg" data-setbg="@item.image_url">
                                            <ul class="product__hover">
                                                <li>
                                                    <a asp-controller="Product_details" asp-action="Index" asp-route-id="@item.id" asp-route-category_id="@item.category_id" asp-route-sup_category_id="@item.sup_category_id">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-controller="Favourite" asp-action="AddToFavourite" asp-route-userId="@ViewBag.userId" asp-route-productId="@item.id">
                                                        <i class="fa-regular fa-heart"></i>
                                                    </a>
                                                </li>
                                                <li>
                                                    @{
                                                        var isInCart = ViewBag.ProductIdsInCart != null &&
                                                                       ((List<int>)ViewBag.ProductIdsInCart).Contains(item.id);
                                                    }
                                                    <a href="javascript:void(0);"
                                                       class="add-to-cart-ajax @(isInCart ? "active-cart" : "")"
                                                       data-id="@item.id">
                                                        <i class="fa-solid fa-bag-shopping"></i>
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="product__item__text">
                                            <h6><a href="/product_details/@item.id">@item.name</a></h6>
                                            <div class="product__price">@item.price EGP</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>
        $(function () {
            toastr.options = {
                closeButton: true,
                progressBar: true,
                newestOnTop: true,
                preventDuplicates: true,
                positionClass: "toast-top-right",
                showDuration: 300,
                hideDuration: 300,
                timeOut: 3000,
                extendedTimeOut: 1000
            };

            $(document).on('click', '.add-to-cart-ajax', function (e) {
                e.preventDefault();
                var btn = $(this);
                var productId = btn.data("id");

                if (!productId) return;

                $.ajax({
                    url: "/shop_cart/AddToCart", 
                    type: "POST",
                    data: {
                        productId: productId
                    },
                    success: function (response) {
                        if (response.success) {
                            if (response.action == "added") {
                                btn.addClass("active-cart");
                                toastr.success(response.message);
                            } 
                            else {
                                btn.removeClass("active-cart");
                                toastr.warning(response.message);
                            }
                            
                            if (typeof window.updateCartCount === "function") {
                                window.updateCartCount();
                            }
                        }
                    },
                    error: function () {
                        toastr.error("حدث خطأ أثناء تنفيذ العملية.");
                    }
                });
            });

            var sortSelect = document.getElementById('sortSelect');
            if (sortSelect) {
                sortSelect.addEventListener('change', function () {
                    var filterForm = document.getElementById('filterForm');
                    if (filterForm) filterForm.submit();
                });
            }

            var filterForm = document.getElementById('filterForm');
            if (filterForm) {
                filterForm.addEventListener('change', function (e) {
                    if (!e.target.classList.contains('add-to-cart-ajax') && e.target.id !== 'minamount' && e.target.id !== 'maxamount') {
                        this.submit();
                    }
                });
            }
        });

        document.addEventListener("DOMContentLoaded", function() {
            const rangeSlider = document.querySelector('.price-range');
            if (rangeSlider) {
                rangeSlider.setAttribute('data-min-val', '@ViewBag.MinPrice');
                rangeSlider.setAttribute('data-max-val', '@ViewBag.MaxPrice');
            }

            // Since this uses auto-submit, we don't strictly need a "Filter" button, but if user drags slider it should submit.
            // Using price slider often triggers external JS setting values. 
            // In the original, they used a "filter-btn". Here, it submits on any change in the form if we want,
            // or we add a specific listener for price. The original category page used `filterForm.addEventListener('change', ...)`
        });
    </script>
}
