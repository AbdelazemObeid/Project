@model project_MVC.Models.Category
@{
    ViewData["Title"] = "Add Category";
    ViewData["ActivePage"] = "Categories";
    Layout = "~/Views/Shared/admin/_adminlayout.cshtml";
}

<section class="content-section active">
    <div class="section-header">
        <h1>Add New Category</h1>
    </div>
    <div class="card">
        <div class="card-body">
            <form asp-action="Create" asp-controller="AdminCategories" method="post">
                <div class="form-group">
                    <label>Category Name</label>
                    <input asp-for="name" class="form-control" placeholder="e.g. Men, Women, Accessories" required />
                    <span asp-validation-for="name" style="color: red; font-size: 0.9em;"></span>
                </div>

                <div class="form-group">
                    <label>Image URL</label>
                    <input asp-for="image_url" class="form-control" placeholder="e.g. https://example.com/cat.jpg or /img/cat.jpg" />
                    <span asp-validation-for="image_url" style="color: red; font-size: 0.9em;"></span>
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top:10px;">Save Category</button>
                <a href="/admin/categories" class="btn btn-secondary" style="margin-top:10px;">Cancel</a>
            </form>
        </div>
    </div>
</section>
