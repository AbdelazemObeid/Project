@model project_MVC.Models.Category
@{
    ViewData["Title"] = "Edit Category";
    ViewData["ActivePage"] = "Categories";
    Layout = "~/Views/Shared/admin/_adminlayout.cshtml";
}

<section class="content-section active">
    <div class="section-header">
        <h1>Edit Category: @Model.name</h1>
    </div>
    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" asp-controller="AdminCategories" method="post">
                <input type="hidden" asp-for="id" />
                
                <div class="form-group">
                    <label>Category Name</label>
                    <input asp-for="name" class="form-control" required />
                    <span asp-validation-for="name" style="color: red; font-size: 0.9em;"></span>
                </div>

                <div class="form-group">
                    <label>Image URL</label>
                    <input asp-for="image_url" class="form-control" />
                    <span asp-validation-for="image_url" style="color: red; font-size: 0.9em;"></span>
                    
                    @if (!string.IsNullOrEmpty(Model.image_url))
                    {
                        <div class="mt-2">
                            <p>Current Image:</p>
                            <img src="@Model.image_url" style="max-width:150px; border-radius:8px;" onerror="this.style.display='none'" />
                        </div>
                    }
                </div>

                <button type="submit" class="btn btn-primary" style="margin-top:10px;">Save Changes</button>
                <a href="/admin/categories" class="btn btn-secondary" style="margin-top:10px;">Cancel</a>
            </form>
        </div>
    </div>
</section>
