@model List<project_MVC.Models.Product>
@{
    ViewData["Title"] = "Manage Products";
    ViewData["ActivePage"] = "Products";
    Layout = "~/Views/Shared/admin/_adminlayout.cshtml";
}

<section class="content-section active">
    <div class="section-header flex-between">
        <div>
            <h1>Manage Products</h1>
            <p>Traditional MVC Product Management</p>
        </div>
        <a href="/admin/products/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add Product</a>
    </div>
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Price</th>
                            <th>Category</th>
                            <th>Qty</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.image_url))
                                    {
                                        <img src="@p.image_url" alt="@p.name"
                                             style="width:55px; height:55px; object-fit:cover; border-radius:8px; border:1px solid #ddd;"
                                             onerror="this.src='/img/product/product-1.jpg.webp'" />
                                    }
                                    else
                                    {
                                        <div style="width:55px; height:55px; background:#f0f0f0; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:24px;">📦</div>
                                    }
                                </td>
                                <td>#@p.id</td>
                                <td><strong>@p.name</strong></td>
                                <td>@p.price EGP</td>
                                <td><span class="badge badge-primary">@(p.category?.name ?? "N/A")</span></td>
                                <td>@p.quantity</td>
                                <td style="display: flex; gap: 5px;">
                                    <a href="/admin/products/details/@p.id" class="btn-icon btn-info" style="margin-right: 5px; color: white; background: #17a2b8; padding: 8px; border-radius: 4px; text-decoration: none;"><i class="fa-solid fa-eye"></i></a>
                                    <a href="/admin/products/edit/@p.id" class="btn-icon btn-edit"><i class="fa-solid fa-pen"></i></a>
                                    <a href="/admin/products/delete/@p.id" class="btn-icon btn-delete" style="margin-right: 5px; color: white; background: #ff4d4d; padding: 8px; border-radius: 4px; text-decoration: none;"><i class="fa-solid fa-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
