@model project_MVC.Models.User
@{
    ViewData["Title"] = "Confirm Delete";
    ViewData["ActivePage"] = "Users";
    Layout = "~/Views/Shared/admin/_adminlayout.cshtml";
}

<section class="content-section active">
    <div class="section-header">
        <h1>Confirm Delete</h1>
    </div>
    <div class="card" style="max-width: 600px; margin: 0 auto; border: 1px solid #ff4d4d;">
        <div class="card-body" style="text-align: center;">
            <div style="font-size: 60px; color: #ff4d4d; margin-bottom: 20px;">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <h3 style="margin-bottom: 20px;">Are you sure you want to delete this user?</h3>
            
            <p style="font-size: 18px; font-weight: bold; margin-bottom: 10px;">@Model.name</p>
            <p style="color: #666; margin-bottom: 30px;">Email: @Model.email <br/> Role: @Model.role</p>

            <form asp-action="Delete" asp-controller="AdminUsers" asp-route-id="@Model.id" method="post" style="display: flex; justify-content: center; gap: 10px;">
                <button type="submit" class="btn btn-danger" style="background-color: #ff4d4d; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px;">
                    <i class="fa-solid fa-trash"></i> Yes, Delete
                </button>
                <a href="/admin/users" class="btn btn-secondary" style="background-color: #e0e0e0; color: #333; padding: 10px 20px; text-decoration: none; border-radius: 5px; font-size: 16px;">
                    Cancel
                </a>
            </form>
        </div>
    </div>
</section>
